###############################################################
# Syed Shajahan Basha — Portfolio
#
# Local development configuration. Drop this in the project root
# as ".env" (same folder as artisan and composer.json).
#
# Before going live:
#   1. php artisan key:generate      (replace the APP_KEY below)
#   2. APP_ENV=production, APP_DEBUG=false
#   3. Fill in the MAIL_* block so the contact form can send
#
# Never commit this file — .gitignore already excludes it.
###############################################################

APP_NAME="Syed Shajahan Basha"
APP_ENV=local
APP_KEY=base64:KHkS+9plI91hWj8ZShXomN2K4TBZCNG59ioBp0VwFcc=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#--------------------------------------------------------------
# Database — not used by this site.
# Sessions, cache and queue all run on the filesystem, so there
# is nothing to migrate. Left here in case you add a blog or an
# admin panel later.
#--------------------------------------------------------------
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

#--------------------------------------------------------------
# Mail — the contact form
#
# "log" writes messages to storage/logs/laravel.log instead of
# sending them, which is what you want while developing.
# Switch MAIL_MAILER to smtp and fill in the rest for production.
#
# Gmail: MAIL_HOST=smtp.gmail.com  MAIL_PORT=587  MAIL_SCHEME=tls
#        MAIL_PASSWORD must be a Google App Password, not your
#        account password (needs 2FA enabled).
#
# cPanel / Hostinger / shared hosting:
#        MAIL_HOST=mail.yourdomain.com  MAIL_PORT=465
#        MAIL_SCHEME=ssl  and use the mailbox's own password.
#--------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.shajahanbasha.com
MAIL_PORT=587
MAIL_USERNAME="no-reply@shajahanbasha.com"
MAIL_PASSWORD="J17Dm2sjk2@"
MAIL_FROM_ADDRESS="no-reply@shajahanbasha.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

#--------------------------------------------------------------
# Site settings
#--------------------------------------------------------------

# Where contact-form enquiries are delivered.
CONTACT_TO_ADDRESS=shajahanbasha.syed@gmail.com

# Bump this after editing public/css/app.css or public/js/app.js
# so browsers fetch the new file instead of a cached copy.
ASSET_VERSION=1
